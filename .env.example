# TCP SecureGate configuration. Copy to .env (never commit real secrets).

# demo | production. Production disables demo login, demo seeding and demo reset,
# enables secure cookies and requires TOKEN_SECRET.
APP_MODE=demo

HOST=127.0.0.1
PORT=3000

# Data directory for the SQLite database (and the generated demo token secret).
DATA_DIR=./data
# DATABASE_FILE=./data/securegate.db

# HMAC key that signs QR/access tokens (min 32 chars). Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# TOKEN_SECRET=

# Establishment time zone used for visit dates, permitted hours and reports.
APP_TIMEZONE=Asia/Kolkata

SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Set true behind HTTPS (default true in production).
# SECURE_COOKIES=true
# Set true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Demo dataset size and automatic seeding on first start (demo mode only).
DEMO_AUTO_SEED=true
DEMO_PERSONNEL_COUNT=1200

SCHEDULER_INTERVAL_SECONDS=60
